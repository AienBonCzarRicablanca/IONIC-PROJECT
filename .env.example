# Copy to .env and fill in from Supabase Dashboard > Project Settings > API.
# Use ONLY the public anon key here. NEVER put the service-role key in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Free key from https://aistudio.google.com/apikey — Pearl uses it to hold a real conversation.
# Restart the dev server after changing this. A free AI Studio key is enough. Do not use a billing key.
VITE_GEMINI_API_KEY=
